 	rts
 
 emit_compare_immediate:
@@ -350,3 +332,16 @@ exprImmediateCompareFinish:
 exprImmediateFinish:
 	byte $09,'t','a','x',$0a
 	byte $09,'t','y','a',$0a,0
+
+exprImmediateShift8:
+	byte $09,'t','x','a',$0a,0
+
+;;; Pointer tables keep instruction selection smaller than four repeated branches.
+arithmeticLowLow:
