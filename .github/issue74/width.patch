diff --git a/nanoc0/expression.asm b/nanoc0/expression.asm
index 74f20de..5058dfa 100644
--- a/nanoc0/expression.asm
+++ b/nanoc0/expression.asm
@@ -724,27 +724,17 @@ try_immediate_binary:
 	lda #IMMEDIATE_BINARY_NONE
 	sta immediateBinaryState
 
+	;;; Immediate RHS lowering covers +, -, comparisons, &, |, and the one
+	;;; exact shift count handled below. OP_SHL is the single hole in that range.
 	lda pendingOperator
 	cmp #OP_ADD
-	beq .supported
-	cmp #OP_SUB
-	beq .supported
-	cmp #OP_AND
-	beq .supported
-	cmp #OP_OR
-	beq .supported
-	cmp #OP_LT
-	beq .supported
-	cmp #OP_LE
-	beq .supported
-	cmp #OP_GT
-	beq .supported
-	cmp #OP_GE
-	beq .supported
-	cmp #OP_EQ
-	beq .supported
-	cmp #OP_NE
-	beq .supported
+	bcc .notImmediate
+	cmp #OP_SHL
+	bcc .supported		; + or -
+	beq .notImmediate	; <<
+	cmp #OP_CALL
+	bcc .supported		; >>, comparisons, &, |
+.notImmediate:
 	sec
 	rts
 
@@ -788,7 +778,9 @@ try_immediate_binary:
 
 .scalar:
 	jsr capture_primary_identifier
-	bcc .failed
+	bcs .scalarCaptured
+	rts
+.scalarCaptured:
 	lda primarySymbolKind
 	cmp #SYMBOL_GLOBAL
 	bne .done
@@ -817,6 +809,20 @@ try_immediate_binary:
 	rts
 
 .reduce:
+	;;; Only the literal count eight has a direct shift form. Other shifts
+	;;; rejoin the established expression path.
+	lda pendingOperator
+	cmp #OP_SHR
+	bne .reduceNow
+	lda immediateBinaryState
+	cmp #IMMEDIATE_BINARY_CAPTURED_LITERAL
+	bne .done
+	lda expressionLiteralValue
+	cmp #$08
+	bne .done
+	lda expressionLiteralValue+1
+	bne .done
+.reduceNow:
 	lda pendingOperator
 	sta reduceOperator
 	lda expressionValueType
diff --git a/nanoc0/expression_immediate.asm b/nanoc0/expression_immediate.asm
index e47a47e..8bd28b4 100644
--- a/nanoc0/expression_immediate.asm
+++ b/nanoc0/expression_immediate.asm
@@ -13,34 +13,49 @@ emit_immediate_binary_reduction:
 	sta expressionTruthInZ
 	lda reduceOperator
 	cmp #OP_ADD
-	beq .arithmetic
-	cmp #OP_SUB
-	beq .arithmetic
-	cmp #OP_AND
-	beq .arithmetic
-	cmp #OP_OR
-	beq .arithmetic
+	bcc .unsupported
+	cmp #OP_SHL
+	bcc .arithmetic		; + or -
+	cmp #OP_SHR
+	beq .shift8
 	cmp #OP_LT
-	beq .compare
-	cmp #OP_LE
-	beq .compare
-	cmp #OP_GT
-	beq .compare
-	cmp #OP_GE
-	beq .compare
-	cmp #OP_EQ
-	beq .compare
-	cmp #OP_NE
-	beq .compare
+	bcc .unsupported	; <<
+	cmp #OP_AND
+	bcc .compare		; < <= > >= == !=
+	cmp #OP_CALL
+	bcc .arithmetic		; & or |
+.unsupported:
 	clc
 	rts
 .arithmetic:
 	jmp emit_arithmetic_immediate
+.shift8:
+	ldx #<exprImmediateShift8
+	ldy #>exprImmediateShift8
+	jsr emit_string
+	bcc .unsupported
+	jmp emit_zero_high
 .compare:
 	jmp emit_compare_immediate
 
 ;;; The four arithmetic/bitwise literal forms differ only in instruction name.
 emit_arithmetic_immediate:
+	;;; AND $ffff is already the value in A/X. AND $00ff only clears X.
+	lda reduceOperator
+	cmp #OP_AND
+	bne .ordinary
+	lda expressionLiteralValue
+	cmp #$ff
+	bne .ordinary
+	lda expressionLiteralValue+1
+	beq .lowMask
+	cmp #$ff
+	bne .ordinary
+	sec
+	rts
+.lowMask:
+	jmp emit_zero_high
+.ordinary:
 	jsr select_arithmetic_low
 	bcc .failed
 	jsr emit_string
@@ -65,69 +80,36 @@ emit_arithmetic_immediate:
 	rts
 
